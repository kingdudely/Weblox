# WebGPU: Dawn at a fixed commit.  The codeload tarball is hash-verified before
# use; a linkable webgpu_dawn library (system or user-supplied) is required to
# define WEBLOX_HAVE_DAWN.  Dawn's GN build needs depot_tools + third_party, so
# the source pin is used for headers/provenance and the runtime library stays
# optional (see docs/CI.md).
DAWN_VERSION=2dc7e645fb7e7d8d10f37bd0e02f622c662e8177
DAWN_SHA256=aaaf9bda60602377f28350b09c57a2364cf477e13e67c6b6654240c97a077785

# WebTransport: ngtcp2 (QUIC) and nghttp3 (HTTP/3) release tarballs.  Both are
# built as static libraries with ENABLE_LIB_ONLY when a TLS provider exists.
NGTCP2_VERSION=1.26.0
NGTCP2_SHA256=bbaa61613f9e79619075f1ce5347f7aa008fd4ee4ffd6964afba4a48ec1dd689
NGHTTP3_VERSION=1.19.0
NGHTTP3_SHA256=f061cc110b932534d5fc6f2c9cf918956cd55de1c3cd0923b6cc0d64ee9d2e30
# nghttp3's lib/sfparse git submodule is not in a codeload tarball; this is
# exactly the gitlink recorded by the pinned nghttp3 tag.
