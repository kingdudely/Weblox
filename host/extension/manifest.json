{
  "manifest_version": 3,
  "name": "RakNet Wasm Client",
  "version": "0.2",
  "description": "Serves a locally patched WebClient.wasm to play.roblox.com and forces the RakNet transport.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://setup.rbxcdn.com/*", "*://play.roblox.com/*"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "module", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    {
      "matches": ["https://play.roblox.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["WebClient.patched.wasm"], "matches": ["https://play.roblox.com/*"] }
  ]
}
