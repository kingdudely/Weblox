.cache/
*.wasm
*.log
*.jsonl
node_modules/
__pycache__/

# staged engine bundle: rebuilt by tools/mirror_engine.py + tools/stage_engine.sh.
# tools/engine.paths is the tracked source of truth for what it should contain.
iwa/engine/

# signed bundle output (build_bundle.sh)
build/bundle/
*.wbn
*.swbn

# rust build output
**/target/

# Native host artifacts (regenerate locally; keep source)
client/client.*.bak/
client/opscheck*/
client/*.pcap
v2-wasmtime/target/
v2-wasmtime/data/cache/
v2-wasmtime/data/content/
v3-wasm2c/gen/
v3-wasm2c/gen/obj/
v3-wasm2c/data/cache/
v3-wasm2c/sliced.c
*.har
*.pch
*.o
*.a
*.so
host/demo
host/*.o
# generated from the wasm element/data sections; regenerate with make
host/table.cpp
host/runtime_data.cpp
# generated callee-pop thunk table; regenerate with make (host/ABI.md)
host/abi_stubs.S

# native host build inputs/outputs (build_all.sh defaults to /tmp/opencode,
# but allow local overrides inside host/ without committing large binaries)
host/*.wasm
host/*.abi.json
host/demo.*
host/build/
