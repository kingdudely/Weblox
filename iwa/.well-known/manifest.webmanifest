{
  "name": "Roblox",
  "short_name": "Roblox",
  "description": "Roblox.",
  "version": "0.4.0",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "launch_handler": { "client_mode": "navigate-existing" },
  "protocol_handlers": [
    { "protocol": "roblox-player", "url": "/?player=%s" },
    { "protocol": "roblox", "url": "/?deeplink=%s" }
  ],
  "icons": [
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "permissions_policy": {
    "cross-origin-isolated": ["self"],
    "direct-sockets": ["self"],
    "controlled-frame": ["self"],
    "fullscreen": ["self"],
    "gamepad": ["self"],
    "screen-wake-lock": ["self"],
    "autoplay": ["self"]
  }
}
