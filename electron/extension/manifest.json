{
  "manifest_version": 3,
  "minimum_chrome_version": "125",
  "name": "Roblox Web Play join patch",
  "version": "0.4.0",
  "description": "Patches public Web Play joins: native identity and the browser transport host name.",
  "content_scripts": [
    {
      "matches": [
        "https://play.roblox.com/games/start*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://play.roblox.com/games/start*"
      ],
      "js": [
        "dbg.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}