# Current Roblox Web build. Update these two lines when Roblox ships a new
# engine build; CI reads this file and fetches the wasm from the matching
# versioned CDN URL on setup.rbxcdn.com.
# Canonical Roblox upload identifier (also used as the Release tag).
WASM_VERSION=version-1ef59424f70d4932-RobloxWebClient
WASM_SHA256=be370a4446dcfce62635f7e6d271526b15e2099507fb7250b2d3360eacd4a61f
# Expected sha256 of each compressed engine bundle; filled after a CI build.
# Replaced by tar.zst bundles; refill after the next matrix build.
ENGINE_LINUX_SHA256=
ENGINE_MACOS_SHA256=
ENGINE_WINDOWS_SHA256=
